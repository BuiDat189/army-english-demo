# Sao chép thành .env rồi chỉnh. KHÔNG đưa file .env (secret thật) vào git.

# Cổng và địa chỉ của server Express (API + frontend đã build)
PORT=3000
HOST=127.0.0.1

# Đường dẫn file SQLite (tương đối từ thư mục gốc dự án)
DB_FILE=data/army-demo.sqlite

# Chế độ demo: bật tài khoản demo (mật khẩu chung), chuyển nhanh tài khoản, nút reset dữ liệu.
# Đặt false ở mọi môi trường không phải demo — khi đó tài khoản demo không đăng nhập được, reset bị khóa.
DEMO_MODE=true

# Khóa ký cookie phiên (>= 24 ký tự ngẫu nhiên). Để trống ở máy demo: server tự sinh và lưu trong DB local.
# Bắt buộc đặt giá trị riêng khi triển khai thật.
SESSION_SECRET=

# true khi chạy sau HTTPS (cookie chỉ gửi qua kết nối bảo mật)
COOKIE_SECURE=false

# Mã truy cập chung trước trang đăng nhập khi đưa demo ra ngoài (ngrok, hosting). Để trống = tắt.
ACCESS_CODE=

# NODE_ENV=production
